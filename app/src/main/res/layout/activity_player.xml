<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#000000">

    <!-- 좌측: 영상 -->
    <FrameLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:background="#000000">

        <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlcPlayer"
            android:layout_width="match_parent" android:layout_height="match_parent"/>

        <!-- 스냅샷 오버레이: 연결 중 이전 프레임 유지, Playing 시 페이드아웃 -->
        <ImageView android:id="@+id/imgSnapshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"/>

        <!-- 상단 상태바 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:background="#EE000000">
            <View android:id="@+id/dotPlayer"
                android:layout_width="12dp" android:layout_height="12dp"
                android:background="@drawable/dot_gray" android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/lblPlayer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="--" android:textColor="#FFFFFF"
                android:textSize="16sp" android:textStyle="bold"
                android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/ipPlayer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#667788" android:textSize="11sp"
                android:layout_marginEnd="8dp"/>
            <TextView android:id="@+id/tvStreamStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="연결 중..." android:textColor="#FFB300"
                android:textSize="11sp" android:textStyle="bold"/>
            <!-- 플렉서블 공간 (좌) -->
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
            <!-- OSD 중앙 배치 -->
            <TextView android:id="@+id/osdWeightPlayer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="중량: --"
                android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
                android:layout_marginEnd="30dp"
                android:visibility="gone"/>
            <TextView android:id="@+id/osdWindPlayer"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="풍속: --"
                android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold"
                android:visibility="gone"/>
            <!-- 플렉서블 공간 (우) -->
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
        </LinearLayout>

        <!-- 더블탭 감지 투명 레이어 -->
        <View android:id="@+id/touchOverlay"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:layout_marginTop="56dp"
            android:background="@android:color/transparent"/>
    </FrameLayout>

    <!-- 우측: PTZ 패널 (고정 레이아웃) -->
    <LinearLayout
        android:layout_width="210dp" android:layout_height="match_parent"
        android:orientation="vertical" android:background="#162030">

        <!-- 아이비온 로고 (패널 최상단, 정사각형) -->
        <ImageView
            android:layout_width="match_parent" android:layout_height="150dp"
            android:src="@drawable/logo_aivion"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:background="#0C1E3C"
            android:paddingStart="8dp" android:paddingEnd="8dp"
            android:paddingTop="8dp" android:paddingBottom="8dp"/>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#1E3050"/>

        <!-- 방향키 ON/OFF: 전체 행 터치 가능 (스위치 우측 끝 불편 해결) -->
        <LinearLayout android:id="@+id/ptzToggleRow"
            android:layout_width="match_parent" android:layout_height="46dp"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:background="@drawable/bg_btn"
            android:layout_marginStart="6dp" android:layout_marginEnd="6dp"
            android:layout_marginTop="20dp" android:layout_marginBottom="4dp"
            android:clickable="true" android:focusable="true">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="▦  방향키  (터치하여 ON/OFF)"
                android:textColor="#DDDDDD" android:textSize="11sp" android:textStyle="bold"/>
            <androidx.appcompat.widget.SwitchCompat android:id="@+id/swPtz"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:checked="true" android:clickable="false" android:focusable="false"/>
        </LinearLayout>

        <!-- 아래로 여백 (14dp, 약 5mm) -->
        <View android:layout_width="match_parent" android:layout_height="14dp"/>

        <!-- D-pad (INVISIBLE로 숨김 → 공간 유지) -->
        <GridLayout android:id="@+id/ptzArea"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:columnCount="3" android:paddingStart="6dp" android:paddingEnd="6dp">
            <Button android:id="@+id/btnNW" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="↖" android:textSize="20sp"
                android:background="@drawable/bg_btn" android:textColor="#BBBBBB"/>
            <Button android:id="@+id/btnN" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="▲" android:textSize="22sp"
                android:background="@drawable/bg_btn" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnNE" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="↗" android:textSize="20sp"
                android:background="@drawable/bg_btn" android:textColor="#BBBBBB"/>
            <Button android:id="@+id/btnW" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="◀" android:textSize="22sp"
                android:background="@drawable/bg_btn" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnStop" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="■" android:textSize="16sp"
                android:background="@drawable/bg_preset" android:textColor="#FF6B6B"/>
            <Button android:id="@+id/btnE" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="▶" android:textSize="22sp"
                android:background="@drawable/bg_btn" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnSW" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="↙" android:textSize="20sp"
                android:background="@drawable/bg_btn" android:textColor="#BBBBBB"/>
            <Button android:id="@+id/btnS" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="▼" android:textSize="22sp"
                android:background="@drawable/bg_btn" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnSE" android:layout_width="0dp" android:layout_height="56dp"
                android:layout_columnWeight="1" android:layout_margin="2dp"
                android:text="↘" android:textSize="20sp"
                android:background="@drawable/bg_btn" android:textColor="#BBBBBB"/>
        </GridLayout>

        <!-- ZOOM: 간격 + 크게 (항상 고정) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:paddingStart="6dp" android:paddingEnd="6dp"
            android:layout_marginBottom="6dp">
            <Button android:id="@+id/btnZoomOut"
                android:layout_width="0dp" android:layout_height="64dp"
                android:layout_weight="1" android:layout_marginEnd="4dp"
                android:text="ZOOM－" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="@drawable/bg_btn"/>
            <Button android:id="@+id/btnZoomIn"
                android:layout_width="0dp" android:layout_height="64dp"
                android:layout_weight="1"
                android:text="ZOOM＋" android:textSize="13sp" android:textStyle="bold"
                android:textColor="#FFFFFF" android:background="@drawable/bg_btn"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#253545" android:layout_marginBottom="6dp"
            android:layout_marginStart="6dp" android:layout_marginEnd="6dp"/>

        <!-- 프리셋 (스크롤) -->
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="6dp" android:paddingEnd="6dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PRESET" android:textColor="#556677"
                    android:textSize="10sp" android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="3dp">
                    <Button android:id="@+id/btnP1" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1" android:layout_marginEnd="3dp"
                        android:text="1" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                    <Button android:id="@+id/btnP2" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1"
                        android:text="2" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="3dp">
                    <Button android:id="@+id/btnP3" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1" android:layout_marginEnd="3dp"
                        android:text="3" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                    <Button android:id="@+id/btnP4" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1"
                        android:text="4" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                </LinearLayout>
                <Button android:id="@+id/btnP5"
                    android:layout_width="match_parent" android:layout_height="62dp"
                    android:layout_marginBottom="3dp"
                    android:text="5  HOME" android:textSize="16sp" android:textStyle="bold"
                    android:textColor="#2979FF" android:background="@drawable/bg_preset"
                    android:minHeight="0dp" android:maxLines="2"
                    android:ellipsize="end"
                    android:padding="4dp" android:includeFontPadding="false"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="3dp">
                    <Button android:id="@+id/btnP6" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1" android:layout_marginEnd="3dp"
                        android:text="6" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                    <Button android:id="@+id/btnP7" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1"
                        android:text="7" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="4dp">
                    <Button android:id="@+id/btnP8" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1" android:layout_marginEnd="3dp"
                        android:text="8" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                    <Button android:id="@+id/btnP9" android:layout_width="0dp" android:layout_height="62dp"
                        android:layout_weight="1"
                        android:text="9" android:textSize="18sp" android:textStyle="bold"
                        android:textColor="#DDDDDD" android:background="@drawable/bg_preset"
                        android:minHeight="0dp" android:maxLines="2"
                        android:ellipsize="end"
                        android:padding="4dp" android:includeFontPadding="false"/>
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="길게 눌러 이름 저장"
                    android:textColor="#445566" android:textSize="9sp" android:gravity="center"/>
            </LinearLayout>
        </ScrollView>

        <!-- 녹화 재생 -->
        <Button android:id="@+id/btnPlayback"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:layout_margin="6dp"
            android:text="📹  녹화 재생" android:textSize="12sp"
            android:textColor="#CCCCCC" android:background="@drawable/bg_btn"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1E2A3A"
    android:padding="4dp">

    <!-- 상단 헤더 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp" android:paddingEnd="8dp"
        android:background="#0C1E3C"
        android:layout_marginBottom="4dp">

        <!-- 아이비온 로고 아이콘 -->
        <ImageView
            android:layout_width="144dp" android:layout_height="56dp"
            android:src="@drawable/logo_aivion_icon"
            android:scaleType="fitCenter"
            android:layout_marginEnd="16dp"/>

        <!-- 중앙 타이틀 -->
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:gravity="center_horizontal">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="타워크레인 와이어 탈선 감시 CCTV 시스템"
                android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
                android:gravity="center"/>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Tower Crane Wire Derailment Monitoring System  ·  AIVION"
                android:textColor="#4A7AB5" android:textSize="10sp"
                android:gravity="center"/>
        </LinearLayout>

        <!-- 우측: 시간 | 설정버튼 (가로 배치) -->
        <TextView android:id="@+id/tvClock"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginStart="12dp" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnSettings"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="⚙  설정" android:textSize="12sp" android:textColor="#CCCCCC"
            android:background="@drawable/bg_btn"
            android:paddingStart="14dp" android:paddingEnd="14dp"/>
    </LinearLayout>

    <!-- 4분할 그리드 -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal"
            android:layout_marginBottom="3dp">

            <FrameLayout android:id="@+id/cell0"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="3dp"
                android:background="#111820">
                <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlc0"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:background="#DD000000">
                    <View android:id="@+id/dot0" android:layout_width="9dp" android:layout_height="9dp"
                        android:background="@drawable/dot_gray" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/lbl0" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/ip0" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textColor="#AACCFF" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="서브" android:textColor="#2979FF"
                        android:textSize="10sp" android:textStyle="bold"
                        android:background="#1a2d40" android:paddingStart="4dp" android:paddingEnd="4dp"/>
                </LinearLayout>
                <!-- CH1 OSD: 중량 실시간 표시 -->
                <LinearLayout android:id="@+id/osdOverlay"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:orientation="vertical"
                    android:background="#DD000000"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:visibility="gone">
                    <TextView android:id="@+id/osdWeight"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚖ 중량: --"
                        android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold"/>
                </LinearLayout>
                <!-- 복귀 시 스냅샷 표시 (블랙 방지) -->
                <ImageView android:id="@+id/snapOverlay0"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
                <View android:id="@+id/touch0"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@android:color/transparent"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/cell1"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="#111820">
                <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlc1"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:background="#DD000000">
                    <View android:id="@+id/dot1" android:layout_width="9dp" android:layout_height="9dp"
                        android:background="@drawable/dot_gray" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/lbl1" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/ip1" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textColor="#AACCFF" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="서브" android:textColor="#2979FF"
                        android:textSize="10sp" android:textStyle="bold"
                        android:background="#1a2d40" android:paddingStart="4dp" android:paddingEnd="4dp"/>
                </LinearLayout>
                <!-- 복귀 시 스냅샷 표시 (블랙 방지) -->
                <ImageView android:id="@+id/snapOverlay1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
                <View android:id="@+id/touch1"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@android:color/transparent"/>
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:orientation="horizontal">

            <FrameLayout android:id="@+id/cell2"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:layout_marginEnd="3dp"
                android:background="#111820">
                <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlc2"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:background="#DD000000">
                    <View android:id="@+id/dot2" android:layout_width="9dp" android:layout_height="9dp"
                        android:background="@drawable/dot_gray" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/lbl2" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/ip2" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textColor="#AACCFF" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="서브" android:textColor="#2979FF"
                        android:textSize="10sp" android:textStyle="bold"
                        android:background="#1a2d40" android:paddingStart="4dp" android:paddingEnd="4dp"/>
                </LinearLayout>
                <!-- 복귀 시 스냅샷 표시 (블랙 방지) -->
                <ImageView android:id="@+id/snapOverlay2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
                <View android:id="@+id/touch2"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@android:color/transparent"/>
            </FrameLayout>

            <FrameLayout android:id="@+id/cell3"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="#111820">
                <org.videolan.libvlc.util.VLCVideoLayout android:id="@+id/vlc3"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="match_parent" android:layout_height="34dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:paddingStart="10dp" android:paddingEnd="10dp"
                    android:background="#DD000000">
                    <View android:id="@+id/dot3" android:layout_width="9dp" android:layout_height="9dp"
                        android:background="@drawable/dot_gray" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/lbl3" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:text="--"
                        android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"
                        android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/ip3" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:textColor="#AACCFF" android:textSize="12sp"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="서브" android:textColor="#2979FF"
                        android:textSize="10sp" android:textStyle="bold"
                        android:background="#1a2d40" android:paddingStart="4dp" android:paddingEnd="4dp"/>
                </LinearLayout>
                <!-- OCR 배지 (영상 우하단) -->
                <TextView android:id="@+id/tvOcrBadge"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="end|bottom"
                    android:layout_margin="6dp"
                    android:text="● OCR"
                    android:textColor="#FFFFFF" android:textSize="10sp" android:textStyle="bold"
                    android:background="#CC2979FF"
                    android:paddingStart="6dp" android:paddingEnd="6dp"
                    android:paddingTop="3dp" android:paddingBottom="3dp"
                    android:visibility="gone"/>
                <!-- 복귀 시 스냅샷 표시 (블랙 방지) -->
                <ImageView android:id="@+id/snapOverlay3"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"/>
                <View android:id="@+id/touch3"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:background="@android:color/transparent"/>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
